# US Importer Hunter — production environment template.
# Platform-neutral: used by docker-compose.prod.yml / scripts/deploy.sh on any
# server, or entered as service variables on any container platform.
# Copy to .env.production (git-ignored) and fill in real values.
# Never commit real secrets. See docs/deployment.md.

APP_ENV=production

# --- Data stores ---
# Either set full URLs (managed Postgres/Redis, or a platform's private
# network URLs)…
DATABASE_URL=
REDIS_URL=
# …or leave them empty and docker-compose.prod.yml uses its bundled
# postgres/redis containers with these settings:
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=importer_hunter

# --- Research extractor (DeepSeek official API) ---
RESEARCH_EXTRACTOR_PROVIDER=deepseek
RESEARCH_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# --- Email draft generator (fake until a real provider is approved) ---
EMAIL_GENERATOR_PROVIDER=fake

# --- Frontend ---
# Server-only: how the Next.js server reaches the backend on the private
# network, e.g. http://<backend-host>:8000. docker-compose.prod.yml sets it
# to http://backend:8000 itself; set it only on other platforms.
# NEVER expose this with a NEXT_PUBLIC_ prefix.
BACKEND_INTERNAL_URL=
# Server-only access passcode for the whole frontend, including the /api/v1
# proxy (HTTP Basic auth; any username, this value as the password). Required
# in production: without it every request is refused with 503.
FRONTEND_ACCESS_PASSWORD=
# Build-time browser flags. Empty API base = same-origin via the proxy.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_ENABLE_RESEARCH=false
# Public origin of the frontend (e.g. https://hunter.example.com), used for
# backend CORS.
FRONTEND_ORIGIN=
# Host interface/port the frontend container publishes on
# (docker-compose.prod.yml). Use 127.0.0.1 behind a reverse proxy on the same
# host so the app is only reachable through it.
FRONTEND_BIND=0.0.0.0
FRONTEND_PORT=3000
