# US Importer Hunter — production environment template (Zeabur / compose.prod)
# Copy to .env.production and fill in real values. Never commit real secrets.

APP_ENV=production

# --- Data stores (Zeabur: use the private-network URLs it generates) ---
# Either set the full URLs…
DATABASE_URL=
REDIS_URL=
# …or, for docker-compose.prod.yml, the discrete Postgres settings:
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=importer_hunter

# --- Research extractor (DeepSeek official API) ---
RESEARCH_EXTRACTOR_PROVIDER=deepseek
RESEARCH_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# --- Email draft generator (fake until a real provider is approved) ---
EMAIL_GENERATOR_PROVIDER=fake

# --- Frontend ---
# Server-only: how the Next.js server reaches the backend on the private
# network (Zeabur: http://<backend-service>.zeabur.internal:8000).
# NEVER expose this with a NEXT_PUBLIC_ prefix.
BACKEND_INTERNAL_URL=
# Build-time browser flags. Empty API base = same-origin via the proxy.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_ENABLE_RESEARCH=true
# Public origin of the frontend, used for backend CORS.
FRONTEND_ORIGIN=
