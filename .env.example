# ============================================================
# US Importer Hunter — environment configuration
# Copy to .env and fill in the secrets. Never commit .env.
# ============================================================

# --- Application ---
APP_NAME=us-importer-hunter
APP_ENV=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost        # "postgres" when running inside docker compose
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=importer_hunter

# --- Redis ---
REDIS_HOST=localhost           # "redis" when running inside docker compose
REDIS_PORT=6379
REDIS_DB=0

# --- AI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- pgAdmin (dev only, docker compose --profile tools) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050
