# ============================================================
# US Importer Hunter — environment configuration
# Copy to .env and adjust local credentials. OPENAI_API_KEY is optional
# while EMAIL_GENERATOR_PROVIDER=fake (the default). Never commit .env.
# ============================================================

# --- Application ---
APP_NAME=us-importer-hunter
APP_ENV=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- PostgreSQL ---
POSTGRES_HOST=localhost        # "postgres" when running inside docker compose
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=importer_hunter

# --- Redis ---
REDIS_HOST=localhost           # "redis" when running inside docker compose
REDIS_PORT=6379
REDIS_DB=0

# --- AI ---
EMAIL_GENERATOR_PROVIDER=fake  # fake | openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Website research extraction (ADR-0027). Fake is the default: no code path
# reaches a paid provider without setting this to openai. A failed real
# extraction is never retried behind the Fake extractor.
RESEARCH_EXTRACTOR_PROVIDER=fake  # fake | openai | deepseek
# Empty falls back to OPENAI_MODEL. Credentials and base URL are reused.
RESEARCH_MODEL=

# DeepSeek official API — used only when RESEARCH_EXTRACTOR_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
RESEARCH_PROMPT_VERSION=website-research-v1
# Total characters of page text sent to the model, shared across pages in
# page_ranker order. Drives extraction cost more than any other setting.
RESEARCH_EXTRACTOR_MAX_INPUT_CHARS=18000

# --- Background prospect runner (PostgreSQL queue, one job per worker) ---
PROSPECT_WORKER_POLL_SECONDS=1
PROSPECT_JOB_LEASE_TTL_SECONDS=120
PROSPECT_JOB_RETRY_DELAY_SECONDS=5
PROSPECT_JOB_MAX_ATTEMPTS=3

# --- Local real-data acceptance gate ---
# Keep false for normal development and synthetic tests. Set true only for an
# explicitly reviewed local D5e run; preflight remains read-only while false.
REAL_DATA_ACKNOWLEDGED=false

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Research panel is an internal testing surface and is OFF unless set to true.
# The research API must not be reachable anonymously (ADR-0026).
NEXT_PUBLIC_ENABLE_RESEARCH=false

# --- pgAdmin (dev only, docker compose --profile tools) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050
